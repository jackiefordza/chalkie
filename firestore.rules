rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && me().isLeagueAdmin == true;
    }

    function isCaptainOrVC() {
      return isSignedIn() && me().role in ['captain', 'viceCaptain'];
    }

    // ── leagues ───────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      // Any signed-in user can search leagues (needed for find-league screen)
      allow read: if isSignedIn();
      // Admin can create a league even before leagueId is set on their user doc
      allow create: if isAdmin();
      allow update: if isAdmin() && me().leagueId == leagueId;
      allow delete: if isAdmin() && me().leagueId == leagueId;
    }

    // ── seasons ───────────────────────────────────────────────────────────
    match /seasons/{seasonId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── divisions ─────────────────────────────────────────────────────────
    match /divisions/{divisionId} {
      allow read: if isSignedIn() && (me().leagueId == resource.data.leagueId || isAdmin());
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── venues ────────────────────────────────────────────────────────────
    // Shared many-to-one with teams (several teams can play out of the same
    // venue) — creation/edits are admin-only so boardCount stays trustworthy
    // for the fixture generator's clash detection; any league member can read.
    match /venues/{venueId} {
      allow read: if isSignedIn() && (me().leagueId == resource.data.leagueId || isAdmin());
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── teams ─────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      // Pending users need to browse teams; admins query by seasonId so need explicit permission
      allow read: if isSignedIn() && (
        me().leagueId == resource.data.leagueId
        || (me().leagueId == null && me().role == 'pending')
        || isAdmin()
      );
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      // Team assignment (captainUserId/viceCaptainUserId) only ever changes as part of
      // an admin or captain approving a joinRequest — see users.allow update below.
      // There is deliberately no self-assign clause here: anyone could otherwise grab
      // an unclaimed captain/VC slot on any team without going through approval.
      allow update: if
        (isAdmin() && me().leagueId == resource.data.leagueId)
        || (isCaptainOrVC() && me().teamId == teamId);
      allow delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── joinRequests ──────────────────────────────────────────────────────
    // Covers three kinds (see JoinRequest.requestType in src/types): a plain new
    // player ('join'), claiming a placeholder player record ('claim'), or asking
    // to become a team's captain/VC ('captainRole'). Who may act on each is
    // enforced on the users/{userId} update below, not here — this collection's
    // rules stay generic across all three types.
    match /joinRequests/{requestId} {
      allow read: if
        (isCaptainOrVC() && me().teamId == resource.data.teamId)
        || (isAdmin() && me().leagueId == resource.data.leagueId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if
        (isCaptainOrVC() && me().teamId == resource.data.teamId)
        || (isAdmin() && me().leagueId == resource.data.leagueId);
      allow delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── players ───────────────────────────────────────────────────────────
    match /players/{playerId} {
      // Also allow read by teamId so captain.tsx query (filtered by teamId) works without needing leagueId in filter.
      // Pending users (no leagueId yet) need to read a team's roster while browsing
      // to find their own name — same allowance teams/{teamId} already has.
      allow read: if isSignedIn() && (
        me().leagueId == resource.data.leagueId
        || me().teamId == resource.data.teamId
        || (me().leagueId == null && me().role == 'pending')
        || isAdmin()
      );

      allow create: if
        (isAdmin() && me().leagueId == request.resource.data.leagueId)
        || (isCaptainOrVC()
            && me().teamId == request.resource.data.teamId);

      // claimedByUserId only ever changes as part of a captain/VC or admin approving
      // a 'claim' joinRequest — no self-claim clause (that would let anyone instantly
      // claim any unclaimed player record without the team's approval).
      allow update: if
        (isAdmin() && me().leagueId == resource.data.leagueId)
        || (isCaptainOrVC() && me().teamId == resource.data.teamId);

      allow delete: if
        (isAdmin() && me().leagueId == resource.data.leagueId)
        || (isCaptainOrVC()
            && me().teamId == resource.data.teamId
            && resource.data.claimedByUserId == null);
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isCaptainOrVC()
        || (me().teamId != null && me().teamId == resource.data.teamId)
      );

      // First sign-up: user creates their own document with role=pending
      allow create: if request.auth.uid == userId
        && request.resource.data.role == 'pending'
        && request.resource.data.leagueId == null
        && request.resource.data.teamId == null
        && request.resource.data.playerId == null
        && request.resource.data.isLeagueAdmin == false;

      allow update: if
        // User updates own safe fields (display name, etc) — role/league/team/
        // admin-status unchanged. isLeagueAdmin is deliberately never in this
        // list — nobody can self-grant it, only an existing admin (or a
        // manual Console edit) can, via the isAdmin() branch below.
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.leagueId == resource.data.leagueId
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.divisionId == resource.data.divisionId
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.isLeagueAdmin == resource.data.isLeagueAdmin)
        // Admin can update any user — covers approving any joinRequest, including
        // granting the 'captain' role, which only admin may ever grant
        || isAdmin()
        // Captain/VC approving a pending user into their OWN team: a plain join or
        // claim request always qualifies; a viceCaptain request only if the approver
        // is that team's actual captain (not just any VC) — captaincy itself is
        // never grantable here, only admin grants it (see clause above). Admin
        // status is likewise never grantable here — isLeagueAdmin must stay
        // unchanged, same reasoning as the safe-fields branch above.
        || (isCaptainOrVC()
            && resource.data.role == 'pending'
            && resource.data.pendingRequestType in ['join', 'claim', 'captainRole']
            && request.resource.data.teamId == me().teamId
            && request.resource.data.isLeagueAdmin == resource.data.isLeagueAdmin
            && (
              request.resource.data.role == 'player'
              || (request.resource.data.role == 'viceCaptain'
                  && me().uid == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.captainUserId)
            ))
        // Pending user sets pendingRequestType/pendingRequestId (submitting a request)
        || (request.auth.uid == userId
            && resource.data.role == 'pending'
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['pendingRequestType', 'pendingRequestId', 'leagueId', 'phone', 'phoneVisibility']));
    }

    // ── matches ───────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;

      match /submissions/{submissionId} {
        function matchData() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        allow read: if isSignedIn() && (
          isAdmin()
          || me().teamId == matchData().homeTeamId
          || me().teamId == matchData().awayTeamId
        );

        // Admin can also submit on behalf of either team — for a captain who's
        // stuck or offline, someone still needs a way to get a result in.
        // submittedByTeamId must still be one of the match's own two teams
        // (not an arbitrary team), same constraint a captain's own submission
        // already has implicitly via me().teamId.
        allow create, update: if matchData().status != 'confirmed'
          && (
            (isCaptainOrVC() && me().teamId == request.resource.data.submittedByTeamId)
            || (isAdmin() && me().leagueId == matchData().leagueId
                && request.resource.data.submittedByTeamId in [matchData().homeTeamId, matchData().awayTeamId])
          );

        // Admin needs this to reset test-league submissions between QA runs
        allow delete: if isAdmin() && me().leagueId == matchData().leagueId;
      }
    }

    // ── divisionTables ────────────────────────────────────────────────────
    // Normally only written by Cloud Functions via the Admin SDK (which
    // bypasses rules entirely) as matches confirm. The admin write clauses
    // below exist for manual standings corrections — a FieldValue.increment
    // from a later match confirmation works correctly on top of whatever
    // absolute values an admin sets here.
    match /divisionTables/{tableId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── playerSeasonStats ─────────────────────────────────────────────────
    // Same reasoning as divisionTables above — admin-only manual correction.
    match /playerSeasonStats/{statsId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── cups (Team Knockout Cup) ──────────────────────────────────────────
    // The bracket itself (cups/cupRounds/cupTies) is normally created and
    // advanced by Cloud Functions via the Admin SDK, which bypasses these
    // rules entirely — the client-facing rules here exist for reads (every
    // league member can see the draw/bracket) and for admin's own manual
    // edits (renaming the cup, correcting a tie's date/venue), plus the
    // exact same submission pattern matches/submissions already uses.
    match /cups/{cupId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    match /cupRounds/{cupRoundId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    match /cupTies/{cupTieId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;

      match /submissions/{submissionId} {
        function tieData() {
          return get(/databases/$(database)/documents/cupTies/$(cupTieId)).data;
        }

        allow read: if isSignedIn() && (
          isAdmin()
          || me().teamId == tieData().homeTeamId
          || me().teamId == tieData().awayTeamId
        );

        allow create, update: if tieData().status != 'confirmed'
          && (
            (isCaptainOrVC() && me().teamId == request.resource.data.submittedByTeamId)
            || (isAdmin() && me().leagueId == tieData().leagueId
                && request.resource.data.submittedByTeamId in [tieData().homeTeamId, tieData().awayTeamId])
          );

        allow delete: if isAdmin() && me().leagueId == tieData().leagueId;
      }
    }

    // ── Singles Knockout ──────────────────────────────────────────────────
    // Individual-player bracket, run as one event on one night — no captain
    // on each side to submit a result independently, so unlike cupTies there
    // is no submissions subcollection at all: the admin/organiser running
    // the night writes each tie's result directly. Same admin-only pattern
    // as everywhere else — creation/advancement is normally via the Admin
    // SDK from Cloud Functions, this covers direct client reads/edits.
    match /singlesCompetitions/{competitionId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    match /singlesTies/{singlesTieId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── singlesRegistrations ─────────────────────────────────────────────
    // Read-only from the client, deliberately. Every mutation — a player
    // self-registering, an admin adding someone manually, removing a
    // registration, or toggling payment status — needs a server-side check
    // (eligibility, "is registration still open", "am I this player")
    // that a security rule can't express as cleanly as a callable can, so
    // all writes go through the Cloud Functions (Admin SDK, which bypasses
    // these rules) instead of a direct client write.
    match /singlesRegistrations/{registrationId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
    }

    // ── fineDefinitions ───────────────────────────────────────────────────
    match /fineDefinitions/{fineDefId} {
      allow read: if isSignedIn() && me().teamId == resource.data.teamId;
      allow create: if isCaptainOrVC() && me().teamId == request.resource.data.teamId;
      allow update, delete: if isCaptainOrVC() && me().teamId == resource.data.teamId;
    }

    // ── fineEntries ───────────────────────────────────────────────────────
    match /fineEntries/{fineEntryId} {
      allow read: if isSignedIn() && me().teamId == resource.data.teamId;
      allow create: if isCaptainOrVC() && me().teamId == request.resource.data.teamId;
      allow update, delete: if isCaptainOrVC() && me().teamId == resource.data.teamId;
    }
  }
}
