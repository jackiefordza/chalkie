rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && me().role == 'admin';
    }

    function isCaptainOrVC() {
      return isSignedIn() && me().role in ['captain', 'viceCaptain'];
    }

    // ── leagues ───────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      // Any signed-in user can search leagues (needed for find-league screen)
      allow read: if isSignedIn();
      // Admin can create a league even before leagueId is set on their user doc
      allow create: if isSignedIn() && me().role == 'admin';
      allow update: if isAdmin() && me().leagueId == leagueId;
      allow delete: if isAdmin() && me().leagueId == leagueId;
    }

    // ── seasons ───────────────────────────────────────────────────────────
    match /seasons/{seasonId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── divisions ─────────────────────────────────────────────────────────
    match /divisions/{divisionId} {
      allow read: if isSignedIn() && (me().leagueId == resource.data.leagueId || isAdmin());
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── teams ─────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      // Pending users need to browse teams; admins query by seasonId so need explicit permission
      allow read: if isSignedIn() && (
        me().leagueId == resource.data.leagueId
        || (me().leagueId == null && me().role == 'pending')
        || isAdmin()
      );
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update: if
        (isAdmin() && me().leagueId == resource.data.leagueId)
        // Captain can update their own team (e.g. playerInviteCode)
        || (isCaptainOrVC() && me().teamId == teamId)
        || (isSignedIn()
            && resource.data.captainUserId == null
            && request.resource.data.captainUserId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['captainUserId']))
        || (isSignedIn()
            && resource.data.viceCaptainUserId == null
            && request.resource.data.viceCaptainUserId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viceCaptainUserId']));
      allow delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── teamRequests ──────────────────────────────────────────────────────
    match /teamRequests/{requestId} {
      allow read: if
        isAdmin()
        || (isSignedIn() && resource.data.captainUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.captainUserId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── joinRequests ──────────────────────────────────────────────────────
    match /joinRequests/{requestId} {
      allow read: if
        (isCaptainOrVC() && me().teamId == resource.data.teamId)
        || (isAdmin() && me().leagueId == resource.data.leagueId)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if
        (isCaptainOrVC() && me().teamId == resource.data.teamId)
        || (isAdmin() && me().leagueId == resource.data.leagueId);
      allow delete: if isAdmin() && me().leagueId == resource.data.leagueId;
    }

    // ── claimCodes ────────────────────────────────────────────────────────
    match /claimCodes/{code} {
      // Any signed-in user can look up a code by exact ID (the code is the credential)
      allow get: if isSignedIn();
      allow list: if isCaptainOrVC() && me().teamId == resource.data.teamId;
      allow create: if
        (isCaptainOrVC() && me().teamId == request.resource.data.teamId)
        || (isAdmin() && me().leagueId == request.resource.data.leagueId);
      allow delete: if
        (isCaptainOrVC() && me().teamId == resource.data.teamId)
        || (isAdmin() && me().leagueId == resource.data.leagueId);
      // User marks code as used
      allow update: if isSignedIn()
        && resource.data.usedByUserId == null
        && request.resource.data.usedByUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByUserId', 'usedAt']);
    }

    // ── players ───────────────────────────────────────────────────────────
    match /players/{playerId} {
      // Also allow read by teamId so captain.tsx query (filtered by teamId) works without needing leagueId in filter
      allow read: if isSignedIn() && (
        me().leagueId == resource.data.leagueId
        || me().teamId == resource.data.teamId
        || isAdmin()
      );

      allow create: if
        (isAdmin() && me().leagueId == request.resource.data.leagueId)
        || (isCaptainOrVC()
            && me().teamId == request.resource.data.teamId)
        || (isSignedIn()
            && request.resource.data.claimedByUserId == request.auth.uid);

      allow update: if
        (isAdmin() && me().leagueId == resource.data.leagueId)
        // Captain can update players on their team (including setting claimedByUserId when approving join)
        || (isCaptainOrVC() && me().teamId == resource.data.teamId)
        // Any signed-in user can claim an unclaimed record
        || (isSignedIn()
            && resource.data.claimedByUserId == null
            && request.resource.data.claimedByUserId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['claimedByUserId', 'claimedAt']));

      allow delete: if
        (isAdmin() && me().leagueId == resource.data.leagueId)
        || (isCaptainOrVC()
            && me().teamId == resource.data.teamId
            && resource.data.claimedByUserId == null);
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || isCaptainOrVC()
        || (me().teamId != null && me().teamId == resource.data.teamId)
      );

      // First sign-up: user creates their own document with role=pending
      allow create: if request.auth.uid == userId
        && request.resource.data.role == 'pending'
        && request.resource.data.leagueId == null
        && request.resource.data.teamId == null
        && request.resource.data.playerId == null;

      allow update: if
        // User updates own safe fields (display name, etc) — role/league/team unchanged
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.leagueId == resource.data.leagueId
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.divisionId == resource.data.divisionId
          && request.resource.data.playerId == resource.data.playerId)
        // Admin can update any user
        || isAdmin()
        // Captain can approve join requests (update role/teamId/playerId of pending users in their league)
        || (isCaptainOrVC()
            && resource.data.pendingRequestType == 'join'
            && me().leagueId == resource.data.leagueId)
        // Pending user sets pendingRequestType/pendingRequestId (submitting a request)
        || (request.auth.uid == userId
            && resource.data.role == 'pending'
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['pendingRequestType', 'pendingRequestId', 'leagueId', 'phone', 'phoneVisibility']))
        // Claim-code / invite-code flow: pending user transitions to active role
        || (request.auth.uid == userId
            && resource.data.role == 'pending'
            && request.resource.data.role in ['captain', 'viceCaptain', 'player']
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['role', 'leagueId', 'teamId', 'divisionId', 'playerId',
                          'pendingRequestType', 'pendingRequestId', 'joinedViaCode',
                          'phone', 'phoneVisibility']));
    }

    // ── joinCodes (legacy Flutter) ────────────────────────────────────────
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if
        (isAdmin() && me().leagueId == request.resource.data.leagueId)
        || (isCaptainOrVC()
            && request.resource.data.role == 'viceCaptain'
            && me().teamId == request.resource.data.teamId);

      allow update: if isSignedIn()
        && resource.data.usedByUserId == null
        && request.resource.data.usedByUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usedByUserId', 'usedAt']);
    }

    // ── matches ───────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isSignedIn() && me().leagueId == resource.data.leagueId;
      allow create: if isAdmin() && me().leagueId == request.resource.data.leagueId;
      allow update, delete: if isAdmin() && me().leagueId == resource.data.leagueId;

      match /submissions/{submissionId} {
        function matchData() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        allow read: if isSignedIn() && (
          isAdmin()
          || me().teamId == matchData().homeTeamId
          || me().teamId == matchData().awayTeamId
        );

        allow create, update: if isCaptainOrVC()
          && me().teamId == request.resource.data.submittedByTeamId
          && matchData().status != 'confirmed';
      }
    }

    // ── divisionTables ────────────────────────────────────────────────────
    match /divisionTables/{tableId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── playerSeasonStats ─────────────────────────────────────────────────
    match /playerSeasonStats/{statsId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── fineDefinitions ───────────────────────────────────────────────────
    match /fineDefinitions/{fineDefId} {
      allow read: if isSignedIn() && me().teamId == resource.data.teamId;
      allow create: if isCaptainOrVC() && me().teamId == request.resource.data.teamId;
      allow update, delete: if isCaptainOrVC() && me().teamId == resource.data.teamId;
    }

    // ── fineEntries ───────────────────────────────────────────────────────
    match /fineEntries/{fineEntryId} {
      allow read: if isSignedIn() && me().teamId == resource.data.teamId;
      allow create: if isCaptainOrVC() && me().teamId == request.resource.data.teamId;
      allow update, delete: if isCaptainOrVC() && me().teamId == resource.data.teamId;
    }
  }
}
